                crm.product_id = (typeof crmVariables !== 'undefined') ? crmVariables.product_id : null;
                crm.page_type = (typeof crmVariables !== 'undefined') ? crmVariables.page_type : null;
                crm.invokingfunc = function (crm) {
                    var requestOptions = {
                        method: 'POST',
                        headers: {
                            'Accept': 'application/json, text/plain, */*',
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({
