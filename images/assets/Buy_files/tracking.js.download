                };
                
                crm.invokingfunc(crm);

                var startCapturingForms = (e) => {
                    /* Capturing forms details*/
                    crm.formdata = {};
                    let hasDataFlag = false;
                    let targetHasForm = e.target.form || null;
                    if (targetHasForm) {
                        let form = e.target.form;
                        crm.formdata['form_id'] = form.id;
                        crm.formdata['form_name'] = form.name;
                        Array.from(form.elements).forEach(function (element) {
                            /*Capturing field other than password type for user data security reason*/
                            if (element.type !== "password") {
                                let inputEl = element.name;
                                if (!inputEl) {
                                    inputEl = element.id;
                                }
                                if (inputEl !== "") {
                                    if (element.value !== "") {
                                        hasDataFlag = true;
                                        /*Handling for input with Dial code*/
                                        let classList = element.className && element.className.split(/\s+/) || [];
                                        for (var i = 0; i < classList.length; i++) {
                                            if (classList[i] === 'intlNumber') {
                                                let intlChildNodes = element.previousSibling.firstChild.childNodes;
                                                for (var i = 0; i < intlChildNodes.length; i++) {
                                                    if (intlChildNodes[i].className == "iti__selected-dial-code") {
                                                        let dial_code = intlChildNodes[i].textContent;
                                                        crm.formdata['dial_code'] = dial_code;
                                                        break;
                                                    }
                                                }
                                                break;
                                            }
                                        }
                                        /*End*/
                                        crm.formdata[inputEl] = element.value;
                                    }
                                }
                            }
                            /*End*/
                        });
                        if (hasDataFlag) {
                            crm.feed_action = "form_submit";
                            crm.invokingfunc(crm);
                        }
                    }
                    /*End*/
                };

                document.addEventListener('click', function (e) {
                    if (e.target.matches('[type="button"]') ||
                            e.target.matches('[type="submit"]')) {
                        startCapturingForms(e);
                    }
                }, false);

                /*Below code is used send post API data */
                const noSearchButton = document.querySelector("#no_search_button");
                if (noSearchButton) {
                    noSearchButton.addEventListener("click", function(ev) {
                        crm.formdata = {};
                        crm.formdata['form_id'] = 'no_search_products';
                        crm.formdata['name'] = 'no_search_products';
